{
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.enable": {
        "nix": true
    },
    "workbench.colorTheme": "Catppuccin Mocha",
    "catppuccin.accentColor": "mauve",
    "catppuccin.italicComments": true,
    "catppuccin.boldKeywords": false,
    "catppuccin.bracketMode": "rainbow",
    "catppuccin.workbenchMode": "default",
    "catppuccin.extraBordersEnabled": true,
    "catppuccin.colorOverrides": {
        "mocha": {
            "base": "#1e1e2e",
            "mauve": "#cba6f7"
        }
    },
    "catppuccin.customUIColors": {
        "mocha": {
            "statusBar.background": "#11111b"
        }
    },
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.semanticHighlighting.enabled": true,
    "editor.tokenColorCustomizations": {
        "[Catppuccin Mocha]": {
            "comments": "#6c7086",
            "textMateRules": [
                {
                    "scope": [
                        "comment",
                        "comment.line",
                        "comment.block",
                        "comment.documentation",
                        "punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#6c7086",
                        "fontStyle": "italic"
                    }
                },
                {
                    "scope": [
                        "keyword",
                        "storage",
                        "storage.type",
                        "storage.modifier"
                    ],
                    "settings": {
                        "foreground": "#cba6f7"
                    }
                },
                {
                    "scope": [
                        "string",
                        "string.quoted"
                    ],
                    "settings": {
                        "foreground": "#f9e2af"
                    }
                },
                {
                    "scope": [
                        "constant.numeric",
                        "constant.language"
                    ],
                    "settings": {
                        "foreground": "#fab387"
                    }
                },
                {
                    "scope": [
                        "entity.name.function",
                        "support.function"
                    ],
                    "settings": {
                        "foreground": "#89b4fa"
                    }
                },
                {
                    "scope": [
                        "entity.name.type",
                        "support.type",
                        "entity.name.class"
                    ],
                    "settings": {
                        "foreground": "#94e2d5"
                    }
                }
            ]
        }
    },
    "editor.semanticTokenColorCustomizations": {
        "[Catppuccin Mocha]": {
            "enabled": true,
            "rules": {
                "comment": "#6c7086",
                "comment.documentation": "#6c7086",
                "keyword": "#cba6f7",
                "string": "#f9e2af",
                "number": "#fab387",
                "function": "#89b4fa",
                "type": "#94e2d5",
                "variable": "#cdd6f4"
            }
        }
    },
    "editorError.foreground": "#f38ba8",
    "editorWarning.foreground": "#f9e2af",
    "editorInfo.foreground": "#89dceb",
    "editorHint.foreground": "#94e2d5",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.enableImages": true,
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#cba6f7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#cdd6f4",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#cba6f7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#f5e0dc"
}